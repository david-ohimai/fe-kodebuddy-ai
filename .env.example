# Where the /api/backend rewrite forwards to (see next.config.ts).
# Server-only, so it can change per environment without rebuilding the client.
API_ORIGIN=https://kodebuddy-ai-be.onrender.com

# Used for server-side calls, and as the fallback for API_ORIGIN above.
NEXT_PUBLIC_API_URL=https://kodebuddy-ai-be.onrender.com

# Skip the same-origin rewrite and call the API directly from the browser.
# Only needed when pointing at a backend the rewrite isn't configured for.
# NEXT_PUBLIC_USE_DIRECT_API=true
